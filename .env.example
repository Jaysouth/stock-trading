# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/smartfx-hub

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Two-Factor Authentication
TWO_FACTOR_APP_NAME=SmartFX Hub

# Broker API Configuration (MT4/MT5)
MT4_API_URL=https://api.metaquotes.com
MT4_API_KEY=your-mt4-api-key
MT5_API_URL=https://api.metaquotes.com
MT5_API_KEY=your-mt5-api-key

# AI Trading Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-ai-service-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Payment Gateway (for deposits/withdrawals)
PAYMENT_GATEWAY_KEY=your-payment-gateway-key
PAYMENT_GATEWAY_SECRET=your-payment-gateway-secret

# Admin Configuration
ADMIN_EMAIL=admin@smartfx-hub.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:3000
