# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/smartfx-hub
MONGODB_TEST_URI=mongodb://localhost:27017/smartfx-hub-test

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Broker API Configuration
BROKER_API_ENDPOINT=https://api.broker.example.com
BROKER_API_KEY=your-broker-api-key

# AI Trading Configuration
AI_MODEL_ENDPOINT=https://ai.example.com/api
AI_API_KEY=your-ai-api-key

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@smartfxhub.com
EMAIL_PASSWORD=your-email-password

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Compliance
AUDIT_LOG_ENABLED=true
KYC_REQUIRED=true
